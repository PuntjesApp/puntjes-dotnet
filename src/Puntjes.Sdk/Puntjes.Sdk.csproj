<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Puntjes.Sdk</RootNamespace>
    <Version>0.0.0</Version>
    <PackageId>Puntjes.Sdk</PackageId>
    <Authors>Puntjes</Authors>
    <Description>The official .NET client for the Puntjes loyalty API: customers, transactions, rewards, vouchers and campaigns.</Description>
    <PackageTags>puntjes;loyalty;api;sdk;kiota</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PuntjesApp/puntjes-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PuntjesApp/puntjes-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Text" Version="2.1.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Puntjes.Sdk.Tests" />
  </ItemGroup>

</Project>
